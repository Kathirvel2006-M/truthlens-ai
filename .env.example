# Keep secrets in hosting environment variables; never commit this file with real keys.
HF_TOKEN=hf_your_token_here
HF_API_BASE=https://router.huggingface.co/hf-inference/models
IMAGE_MODEL=umm-maybe/AI-image-detector
# Video is currently frame-based and uses IMAGE_MODEL.
# For audio, deploy a compatible audio deepfake model endpoint and set:
AUDIO_ENDPOINT_URL=
MAX_UPLOAD_MB=40
MAX_VIDEO_FRAMES=8
